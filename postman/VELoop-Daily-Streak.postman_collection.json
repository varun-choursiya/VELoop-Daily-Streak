{
  "info": {
    "name": "VELoop Daily Streak API",
    "description": "Postman collection for the VELoop Rewards Daily Streak MERN project.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "token", "value": "" },
    { "key": "email", "value": "demo@veloop.local" },
    { "key": "password", "value": "Demo@12345" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Demo\",\n  \"email\": \"{{$randomEmail}}\",\n  \"password\": \"Demo@12345\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Registration returns success', function () { pm.expect(pm.response.code).to.be.oneOf([201, 409]); });",
                "if (pm.response.code === 201) { pm.collectionVariables.set('token', pm.response.json().token); }"
              ]
            }
          }]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Login succeeds', function () { pm.response.to.have.status(200); });",
                "pm.collectionVariables.set('token', pm.response.json().token);"
              ]
            }
          }]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "Daily Streak",
      "item": [
        {
          "name": "Get Streak",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/daily-streak"
          }
        },
        {
          "name": "Get History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/daily-streak/history"
          }
        },
        {
          "name": "Claim Current Reward",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{baseUrl}}/daily-streak/claim"
          }
        },
        {
          "name": "Security - Fake Day/Reward Payload",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"day\": 7,\n  \"reward\": 5000,\n  \"currency\": \"VES\",\n  \"userId\": \"someone-else\"\n}"
            },
            "url": "{{baseUrl}}/daily-streak/claim"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Untrusted claim payload is rejected', function () { pm.response.to.have.status(400); });"
              ]
            }
          }]
        }
      ]
    },
    {
      "name": "Wallet",
      "item": [
        {
          "name": "Get Wallet",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/wallet"
          }
        },
        {
          "name": "Get Wallet Transactions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/wallet/transactions"
          }
        }
      ]
    },
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "http://localhost:5000/health"
      }
    }
  ]
}
